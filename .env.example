# Cotizador: envío de leads por correo (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
# Destinatario de las solicitudes de cotización (opcional; default: ricardo@ricolinos.com)
# QUOTE_TO_EMAIL=tu@correo.com

# ── Sync Clerk → Prisma (src/app/api/webhooks/clerk/route.ts) ──────────────
# Signing Secret del endpoint en Clerk Dashboard → Webhooks (eventos
# user.created / user.updated / user.deleted, apuntando a /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret_here

# ── Plan Pro: Stripe (checkout hosted + Customer Portal + webhook) ─────────
# Claves de la cuenta de Stripe (https://dashboard.stripe.com/apikeys) — usa
# las de modo test en local/dev, las live solo en producción.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Signing secret del endpoint en Stripe Dashboard → Webhooks (o `stripe
# listen --forward-to localhost:3000/api/webhooks/stripe` en local), eventos
# checkout.session.completed / customer.subscription.created|updated|deleted
# / invoice.payment_failed, apuntando a /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Id de la Billing Portal Configuration custom (cancelación solo a fin de
# periodo, cambio de periodicidad con prorrateo always_invoice), aprovisionada
# de forma idempotente por `node --env-file=.env.local scripts/stripe-setup.mjs`.
# Opcional: si no se setea, createPortalSession() usa la configuración default
# de la cuenta de Stripe.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_your_portal_configuration_id_here
# Base URL de la app, usada para construir success_url/cancel_url/return_url
# de Stripe Checkout y el Customer Portal (sin slash final)
APP_URL=http://localhost:3000

# ── Agent Studio (scripts/agent-studio.ts) ──────────────────────────────────
# API key de Anthropic (https://platform.claude.com) — requerida
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
# Modelo a usar (opcional; default: claude-opus-4-8)
# AGENT_MODEL=claude-opus-4-8
# Máx. turnos del agentic loop por agente (opcional; default: 40)
# AGENT_MAX_TURNS=40
# Máx. reintentos del bucle de autocorrección de typecheck (opcional; default: 5)
# AGENT_MAX_FIX_ATTEMPTS=5